ARG FP32_SERVICE_IMAGE=gigaam-service:alpine

# Берём уже проверенный musl Runtime; повторная компиляция ONNX не нужна.
FROM ${FP32_SERVICE_IMAGE} AS runtime-source

# Код сервиса тот же. Только внутри этой сборки встраиваем INT8-манифест,
# чтобы модель хранилась в отдельном каталоге precision=int8.
FROM golang:1.26.1-alpine3.23 AS build
RUN apk add --no-cache build-base
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY experiments/int8/manifest.json ./internal/models/manifest.json
RUN GOMAXPROCS=6 CGO_ENABLED=1 go build -trimpath -ldflags='-s -w' -o /out/gigaam ./cmd/gigaam

# Готовые INT8 encoder/decoder/joint из той же ревизии, что и FP32.
# Загрузчик проверяет размеры и SHA-256. VAD и словарь не меняются.
FROM alpine:3.24.1 AS model-files
RUN apk add --no-cache ca-certificates curl jq
COPY experiments/int8/manifest.json /tmp/manifest.json
COPY scripts/download-models.sh /usr/local/bin/download-models
RUN sh /usr/local/bin/download-models /tmp/manifest.json /models gigaam-v3-e2e-rnnt

# Собираем отдельный образ, чтобы FP32-веса не занимали место в его слоях.
FROM alpine:3.24.1
RUN apk add --no-cache ca-certificates ffmpeg curl libstdc++ libgcc \
    && addgroup -g 10001 gigaam \
    && adduser -D -H -u 10001 -G gigaam -s /sbin/nologin gigaam \
    && mkdir -p /models /work /usr/share/licenses/onnxruntime \
    && chown gigaam:gigaam /models /work && chmod 700 /models /work
COPY --from=runtime-source /usr/local/lib/ /usr/local/lib/
COPY --from=runtime-source /usr/share/licenses/onnxruntime/ /usr/share/licenses/onnxruntime/
COPY --from=model-files --chown=10001:10001 /models/ /models/
COPY --from=build /out/gigaam /usr/local/bin/gigaam
ENV GIGAAM_MODEL=gigaam-v3-e2e-rnnt GIGAAM_PORT=8080 GIGAAM_MODEL_DIR=/models GIGAAM_WORK_DIR=/work \
    GIGAAM_ORT_LIBRARY=/usr/local/lib/libonnxruntime.so
USER 10001:10001
WORKDIR /work
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD curl --fail --silent --show-error "http://127.0.0.1:${GIGAAM_PORT}/healthz" || exit 1
ENTRYPOINT ["/usr/local/bin/gigaam"]
