ARG GIGAAM_MODEL=gigaam-v3-e2e-rnnt

# Этап 1: собираем CGo-бинарник с musl, той же libc, что и в рабочем Alpine.
FROM golang:1.26.1-alpine3.23 AS build
RUN apk add --no-cache build-base
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=1 go build -trimpath -ldflags='-s -w' -o /out/gigaam ./cmd/gigaam

# Этап 2: собираем ONNX Runtime из исходников под musl, без слоя совместимости glibc.
# Зависимости CMake берутся из закреплённого списка cmake/deps.txt самого ONNX Runtime.
# Два параллельных процесса ограничивают расход ОЗУ при компиляции C++.
FROM alpine:3.24.1 AS runtime-library
ARG ORT_BUILD_JOBS=2
ARG TARGETARCH
RUN apk add --no-cache build-base linux-headers cmake ninja python3 bash git curl ca-certificates
WORKDIR /src/onnxruntime
RUN curl --fail --location --retry 3 --max-time 600 \
      https://github.com/microsoft/onnxruntime/archive/refs/tags/v1.29.0.tar.gz -o /tmp/ort.tar.gz \
    && echo '9ea05f5279fc93fd243a967f3664aaabe9216f6e3ce9358ead662653984476e9cb0cb950947f31f8602541224c946a3ceac91d7c1990ffe2b8314d61361c300f  /tmp/ort.tar.gz' | sha512sum -c - \
    && tar -xzf /tmp/ort.tar.gz --strip-components=1 \
    && rm /tmp/ort.tar.gz
RUN --mount=type=cache,id=gigaam-ort-musl-1.29.0-${TARGETARCH},target=/src/onnxruntime/build \
    cmake -S cmake -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -Donnxruntime_BUILD_SHARED_LIB=ON \
      -Donnxruntime_BUILD_UNIT_TESTS=OFF \
      -Donnxruntime_ENABLE_PYTHON=OFF \
      -DFLATBUFFERS_LOCALE_INDEPENDENT=OFF \
    && cmake --build build --parallel "$ORT_BUILD_JOBS" \
    && mkdir -p /ort/lib \
    && cp -P build/libonnxruntime.so* /ort/lib/ \
    && if [ -f build/libonnxruntime_providers_shared.so ]; then cp build/libonnxruntime_providers_shared.so /ort/lib/; fi \
    && strip /ort/lib/libonnxruntime.so.* \
    && cp LICENSE ThirdPartyNotices.txt /ort/

# Этап 3: модели и VAD скачиваются и проверяются при сборке, как в Debian-варианте.
FROM alpine:3.24.1 AS model-files
ARG GIGAAM_MODEL
RUN apk add --no-cache ca-certificates curl jq
COPY internal/models/manifest.json /tmp/manifest.json
COPY scripts/download-models.sh /usr/local/bin/download-models
RUN sh /usr/local/bin/download-models /tmp/manifest.json /models "$GIGAAM_MODEL"

# Дополнительная цель для Go-тестов с той же musl-библиотекой ONNX.
FROM build AS test
RUN apk add --no-cache ffmpeg
COPY --from=runtime-library /ort/lib/ /usr/local/lib/
RUN go test ./... && go vet ./...

# Этап 4: рабочий Alpine содержит только сервис, musl-версию ONNX, FFmpeg и модели.
# Компиляторы, исходники ONNX и Python остаются в сборочных этапах.
FROM alpine:3.24.1
RUN apk add --no-cache ca-certificates ffmpeg curl libstdc++ libgcc \
    && addgroup -g 10001 gigaam \
    && adduser -D -H -u 10001 -G gigaam -s /sbin/nologin gigaam \
    && mkdir -p /models /work /usr/share/licenses/onnxruntime \
    && chown gigaam:gigaam /models /work && chmod 700 /models /work
COPY --from=runtime-library /ort/lib/ /usr/local/lib/
COPY --from=runtime-library /ort/LICENSE /ort/ThirdPartyNotices.txt /usr/share/licenses/onnxruntime/
COPY --from=model-files --chown=10001:10001 /models/ /models/
COPY --from=build /out/gigaam /usr/local/bin/gigaam
ARG GIGAAM_MODEL
ENV GIGAAM_MODEL=${GIGAAM_MODEL} GIGAAM_PORT=8080 GIGAAM_MODEL_DIR=/models GIGAAM_WORK_DIR=/work \
    GIGAAM_ORT_LIBRARY=/usr/local/lib/libonnxruntime.so
USER 10001:10001
WORKDIR /work
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD curl --fail --silent --show-error "http://127.0.0.1:${GIGAAM_PORT}/healthz" || exit 1
ENTRYPOINT ["/usr/local/bin/gigaam"]
