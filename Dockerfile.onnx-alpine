# Подготовка ONNX под musl: scripts/prepare-onnx-alpine.sh.
# Архив ONNX и его CMake-зависимости закреплены контрольными суммами.
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS runtime-library
ARG ORT_BUILD_JOBS=2
ARG TARGETARCH
RUN apk add --no-cache build-base linux-headers cmake ninja python3 bash git curl ca-certificates
WORKDIR /src/onnxruntime
RUN curl --fail --location --retry 3 --max-time 600 \
      https://github.com/microsoft/onnxruntime/archive/refs/tags/v1.29.0.tar.gz -o /tmp/ort.tar.gz \
    && echo '9ea05f5279fc93fd243a967f3664aaabe9216f6e3ce9358ead662653984476e9cb0cb950947f31f8602541224c946a3ceac91d7c1990ffe2b8314d61361c300f  /tmp/ort.tar.gz' | sha512sum -c - \
    && tar -xzf /tmp/ort.tar.gz --strip-components=1 \
    && rm /tmp/ort.tar.gz
# GCC 15 на x86 предупреждает о maybe-uninitialized в своём bits/unicode.h.
# Для logging.cc оставляем предупреждение видимым, но не превращаем его в ошибку.
RUN --mount=type=cache,id=gigaam-ort-musl-1.29.0-${TARGETARCH},target=/src/onnxruntime/build \
    printf '%s\n' \
      'if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 15 AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 16)' \
      '  set_source_files_properties("${ONNXRUNTIME_ROOT}/core/common/logging/logging.cc" PROPERTIES COMPILE_OPTIONS "-Wno-error=maybe-uninitialized")' \
      'endif()' >> cmake/onnxruntime_common.cmake \
    && cmake -S cmake -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -Donnxruntime_BUILD_SHARED_LIB=ON \
      -Donnxruntime_BUILD_UNIT_TESTS=OFF \
      -Donnxruntime_ENABLE_PYTHON=OFF \
      -DFLATBUFFERS_LOCALE_INDEPENDENT=OFF \
    && cmake --build build --parallel "$ORT_BUILD_JOBS" \
    && mkdir -p /ort/lib \
    && cp -P build/libonnxruntime.so* /ort/lib/ \
    && if [ -f build/libonnxruntime_providers_shared.so ]; then cp build/libonnxruntime_providers_shared.so /ort/lib/; fi \
    && strip /ort/lib/libonnxruntime.so.* \
    && cp LICENSE ThirdPartyNotices.txt /ort/

# Экспортируем библиотеку, лицензии и сведения для проверки при сборке сервиса.
RUN printf '%s\n' "$TARGETARCH" > /ort/architecture \
    && printf '%s\n' '1.29.0' > /ort/version \
    && apk info -vv | sort > /ort/build-packages.txt \
    && cd /ort \
    && sha256sum lib/* LICENSE ThirdPartyNotices.txt architecture version build-packages.txt > SHA256SUMS

FROM scratch AS artifact
COPY --from=runtime-library /ort/ /
