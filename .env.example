# Generate a secret: openssl rand -hex 32
GIGAAM_API_KEY=
GIGAAM_MODEL=gigaam-v3-e2e-rnnt
# fp32 or int8; affects model download at build time and model selection at startup.
GIGAAM_PRECISION=fp32
GIGAAM_PORT=8080
GIGAAM_CONCURRENCY=1
GIGAAM_ONNX_THREADS=4
GIGAAM_MAX_FILE_BYTES=21474836480
GIGAAM_MAX_DURATION=4h
GIGAAM_UPLOAD_TIMEOUT=30m
GIGAAM_PROCESS_TIMEOUT=60m
GIGAAM_RESPONSE_TIMEOUT=5m
GIGAAM_GRACE_PERIOD=90s
GIGAAM_RESERVE_BYTES=536870912
GIGAAM_CHUNK_DURATION=20s
GIGAAM_OVERLAP=1s
GIGAAM_PADDING=300ms
GIGAAM_MIN_SILENCE=500ms
GIGAAM_VAD_THRESHOLD=0.5
GIGAAM_HEALTH_START_PERIOD=120s
# Must exceed grace period plus the longest native call / response cleanup.
GIGAAM_STOP_GRACE_PERIOD=7m
